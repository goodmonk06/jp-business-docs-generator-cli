// Prisma schema for jp-business-docs-generator-cli

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Template Categories for organization
model TemplateCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  slug        String     @unique
  icon        String?
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  templates   Template[]

  @@map("template_categories")
}

// Database-backed templates (in addition to file-based ones)
model Template {
  id                      String            @id @default(cuid())
  name                    String
  slug                    String            @unique
  version                 String            @default("1.0.0")
  purpose                 String
  audience                String
  requiredSections        Json              // Array of section names
  tone                    String
  parameters              Json              // Array of parameter definitions
  additionalInstructions  String?
  isActive                Boolean           @default(true)
  isPublic                Boolean           @default(false)
  categoryId              String?
  category                TemplateCategory? @relation(fields: [categoryId], references: [id])
  tags                    String[]          @default([])
  metadata                Json?             // Flexible metadata
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  documents               Document[]
  templateVersions        TemplateVersion[]

  @@map("templates")
}

// Version history for templates
model TemplateVersion {
  id          String   @id @default(cuid())
  templateId  String
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     String
  content     Json     // Full template content snapshot
  changelog   String?
  createdAt   DateTime @default(now())
  createdBy   String?

  @@unique([templateId, version])
  @@map("template_versions")
}

// Generated documents with full metadata
model Document {
  id                String             @id @default(cuid())
  title             String
  templateId        String?
  template          Template?          @relation(fields: [templateId], references: [id])
  templateSnapshot  Json               // Snapshot of template at generation time
  parameters        Json               // Parameters used for generation
  content           String             @db.Text
  format            String             @default("markdown") // markdown, pdf, docx, html
  status            DocumentStatus     @default(DRAFT)
  generationJobId   String?
  generationJob     GenerationJob?     @relation(fields: [generationJobId], references: [id])
  metadata          DocumentMetadata?
  versions          DocumentVersion[]
  llmProvider       String             @default("openai")
  llmModel          String             @default("gpt-4o-mini")
  tokenCount        Int?
  generationTimeMs  Int?
  cost              Float?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([templateId])
  @@index([status])
  @@index([createdAt])
  @@map("documents")
}

enum DocumentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
}

// Extended metadata for documents
model DocumentMetadata {
  id           String   @id @default(cuid())
  documentId   String   @unique
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author       String?
  reviewer     String?
  approver     String?
  department   String?
  projectCode  String?
  fiscalYear   Int?
  tags         String[] @default([])
  customFields Json?    // Flexible key-value storage
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("document_metadata")
}

// Document version history
model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    Int
  content    String   @db.Text
  changelog  String?
  createdAt  DateTime @default(now())
  createdBy  String?

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

// Batch generation jobs
model GenerationJob {
  id              String             @id @default(cuid())
  name            String?
  status          GenerationJobStatus @default(PENDING)
  totalDocuments  Int
  completedCount  Int                @default(0)
  failedCount     Int                @default(0)
  documents       Document[]
  inputData       Json?              // Original input (e.g., CSV data)
  configuration   Json?              // Job-specific config
  startedAt       DateTime?
  completedAt     DateTime?
  error           String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("generation_jobs")
}

enum GenerationJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// System metrics and analytics
model GenerationMetric {
  id              String   @id @default(cuid())
  metricType      String   // "generation", "error", "cost", etc.
  templateId      String?
  documentId      String?
  provider        String?
  model           String?
  tokenCount      Int?
  cost            Float?
  durationMs      Int?
  success         Boolean
  errorMessage    String?  @db.Text
  metadata        Json?
  timestamp       DateTime @default(now())

  @@index([metricType])
  @@index([timestamp])
  @@index([templateId])
  @@map("generation_metrics")
}

// Cache for LLM responses
model LLMCache {
  id              String   @id @default(cuid())
  cacheKey        String   @unique // Hash of template + parameters
  provider        String
  model           String
  prompt          String   @db.Text
  response        String   @db.Text
  tokenCount      Int
  cost            Float?
  hitCount        Int      @default(1)
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  lastAccessedAt  DateTime @default(now())

  @@index([cacheKey])
  @@index([expiresAt])
  @@map("llm_cache")
}

// Configuration store
model Configuration {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  category  String?
  isSecret  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("configurations")
}
